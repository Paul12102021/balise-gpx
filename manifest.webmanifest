{
  "name": "Pisteo",
  "short_name": "Pisteo",
  "description": "Suivre une trace GPX, naviguer à pied ou à vélo, même sans réseau",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1d2a24",
  "theme_color": "#1d2a24",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "gpx",
          "accept": [
            ".gpx",
            "application/gpx+xml",
            "application/octet-stream",
            "application/xml",
            "text/xml"
          ]
        }
      ]
    }
  },
  "id": "./"
}